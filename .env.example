# ==============================================================================
# SMART MARKET WATCHLIST - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE BACKEND RUNTIME (REQUIRED FOR PHASE 1)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PHASE 2)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/smart_watchlist_db?schema=public

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION CONFIGURATION (PHASE 3)
# ------------------------------------------------------------------------------
# Secret key for signing JWT tokens (Required in Phase 3)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 4. CACHING & BACKGROUND JOBS (PHASE 7)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
MARKET_REFRESH_INTERVAL_MS=60000
STALE_DATA_THRESHOLD_MS=300000
CACHE_TTL_DEFAULT=60

# ------------------------------------------------------------------------------
# 5. MARKET DATA PROVIDER INTEGRATION (PHASE 8)
# ------------------------------------------------------------------------------
# Market data provider engine: 'mock' for local dev/testing, 'real' for live API
MARKET_DATA_PROVIDER=mock

# External market data API credentials (never commit real keys)
MARKET_API_KEY=your_market_data_api_key_here
MARKET_API_BASE_URL=https://api.marketdata.app/v1

