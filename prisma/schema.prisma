generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String               @id @default(uuid()) @db.Uuid
  email        String               @unique @db.VarChar(255)
  passwordHash String               @map("password_hash") @db.VarChar(255)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  watchlists   Watchlist[]
  visits       UserWatchlistVisit[]

  @@map("users")
}

model Watchlist {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  name        String               @db.VarChar(100)
  description String?              @db.Text
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       WatchlistItem[]
  visits      UserWatchlistVisit[]

  @@index([userId])
  @@map("watchlists")
}

model Stock {
  id        String          @id @default(uuid()) @db.Uuid
  symbol    String          @db.VarChar(20)
  exchange  String          @default("NSE") @db.VarChar(20)
  name      String          @db.VarChar(255)
  sector    String?         @db.VarChar(100)
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  items     WatchlistItem[]
  snapshots StockSnapshot[]

  @@unique([symbol, exchange])
  @@index([symbol])
  @@map("stocks")
}

model WatchlistItem {
  id          String    @id @default(uuid()) @db.Uuid
  watchlistId String    @map("watchlist_id") @db.Uuid
  stockId     String    @map("stock_id") @db.Uuid
  addedAt     DateTime  @default(now()) @map("added_at")
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  stock       Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, stockId])
  @@index([watchlistId])
  @@index([stockId])
  @@map("watchlist_items")
}

model UserWatchlistVisit {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  watchlistId   String    @map("watchlist_id") @db.Uuid
  lastVisitedAt DateTime  @default(now()) @map("last_visited_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlist     Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([userId, watchlistId])
  @@index([userId])
  @@index([watchlistId])
  @@map("user_watchlist_visits")
}

model StockSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  stockId       String   @map("stock_id") @db.Uuid
  price         Decimal  @db.Decimal(12, 2)
  volume        BigInt
  changePercent Float    @map("change_percent")
  recordedAt    DateTime @default(now()) @map("recorded_at")
  stock         Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId, recordedAt])
  @@map("stock_snapshots")
}
